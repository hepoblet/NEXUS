# Requiem configuration for this project. Plain KEY=value, read by agents, hooks and the installer.

# Stack installed under .requiem/stack/. Change it with: requiem update <project> --stack <name>
STACK=react-native-bare

# Active methods, comma-separated: sdd, tdd, bdd, odd (files under .requiem/methods/).
METHODS=sdd,tdd

# Branch flow (see docs/WORKFLOW.md). Work merges into DEV and is promoted DEV -> STAGE -> PROD.
BRANCH_DEV=development
BRANCH_STAGE=stage
BRANCH_PROD=production
